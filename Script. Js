document.addEventListener("DOMContentLoaded", () => {

  const sabores = {
    "LOST M": [
      "Strawberry Ice",
      "Peach Mango Watermelon",
      "Sakura Grape"
    ],

    "IGNITE": [
      "Peach Mango",
      "Blue Raspberry Ice",
      "Pineapple Ice"
    ],

    "FUME": [
      "Watermelon Ice",
      "Blue Razz",
      "Mango"
    ],

    "DINNER": [
      "Grape Ice",
      "Mango Ice",
      "Watermelon Ice"
    ],

    "BANKING": [
      "Strawberry Ice",
      "Blueberry Ice",
      "Grape Ice"
    ],

    "ELFBAR": [
      "BC15",
      "BC15",
      "BC15"
    ]
  };


  /* ESTILO DO CARDÁPIO */

  const estilo = document.createElement("style");

  estilo.textContent = `
    .menu-sabores {
      position: fixed;
      inset: 0;
      z-index: 9999;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 20px;
      background: rgba(0,0,0,0.80);
      backdrop-filter: blur(10px);
    }

    .menu-sabores.aberto {
      display: flex;
    }

    .menu-card {
      width: min(420px, 100%);
      max-height: 85vh;
      overflow-y: auto;
      background: #111;
      color: white;
      border: 1px solid rgba(180,100,255,0.4);
      border-radius: 22px;
      padding: 24px;
      box-shadow: 0 20px 70px rgba(0,0,0,0.7);
    }

    .menu-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }

    .menu-card h3 {
      margin: 0;
      font-size: 25px;
      letter-spacing: 0.5px;
    }

    .fechar {
      width: 40px;
      height: 40px;
      border: none;
      border-radius: 50%;
      background: #222;
      color: white;
      font-size: 25px;
      cursor: pointer;
    }

    .lista-sabores {
      display: grid;
      gap: 10px;
    }

    .sabor-item {
      padding: 16px;
      border-radius: 14px;
      background: linear-gradient(
        135deg,
        rgba(125,55,180,0.25),
        rgba(255,255,255,0.05)
      );
      border: 1px solid rgba(255,255,255,0.08);
      font-weight: 600;
    }

    .sabor-numero {
      opacity: 0.45;
      margin-right: 8px;
    }

    .collection {
      cursor: pointer;
    }
  `;

  document.head.appendChild(estilo);


  /* CRIA O CARDÁPIO */

  const modal = document.createElement("div");

  modal.className = "menu-sabores";

  modal.innerHTML = `
    <div class="menu-card">

      <div class="menu-card-top">

        <h3 id="titulo-sabores">
          Sabores
        </h3>

        <button class="fechar">
          ×
        </button>

      </div>

      <div class="lista-sabores"></div>

    </div>
  `;

  document.body.appendChild(modal);


  const titulo = modal.querySelector("#titulo-sabores");
  const lista = modal.querySelector(".lista-sabores");


  /* QUANDO CLICAR EM UMA MARCA */

  document.querySelectorAll(".collection").forEach((card) => {

    const nome = card.querySelector("strong");

    if (!nome) return;

    const marca = nome.textContent.trim();


    card.addEventListener("click", () => {

      const listaAtual = sabores[marca] || [];

      titulo.textContent = `${marca} — SABORES`;

      lista.innerHTML = listaAtual.map((sabor, index) => {

        return `
          <div class="sabor-item">
            <span class="sabor-numero">
              ${String(index + 1).padStart(2, "0")}
            </span>

            ${sabor}
          </div>
        `;

      }).join("");


      modal.classList.add("aberto");

      document.body.style.overflow = "hidden";

    });

  });


  /* FECHAR O CARDÁPIO */

  const fechar = () => {

    modal.classList.remove("aberto");

    document.body.style.overflow = "";

  };


  modal
    .querySelector(".fechar")
    .addEventListener("click", fechar);


  modal.addEventListener("click", (evento) => {

    if (evento.target === modal) {

      fechar();

    }

  });


  document.addEventListener("keydown", (evento) => {

    if (evento.key === "Escape") {

      fechar();

    }

  });

});
